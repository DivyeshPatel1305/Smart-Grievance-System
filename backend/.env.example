SECRET_KEY=your-super-secret-key-change-in-production-use-50-chars
DEBUG=True

# ─── MongoDB ───────────────────────────────────────────────────────────────
DB_NAME=grievance_platform
DB_URL=mongodb://root:yourpassword@localhost:27017/grievance_platform?authSource=admin
DB_USER=root
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=27017

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Email ─────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# ─── CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Django ────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1,backend,::1

SUPPORT_THRESHOLD=10
